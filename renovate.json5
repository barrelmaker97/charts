{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // Every chart update is a PR that gets the lint and install tests, and
  // merging releases the chart. Only workflow updates automerge; see the last
  // package rule.
  extends: ['config:recommended'],
  timezone: 'America/Chicago',
  customManagers: [
    {
      description: "A chart's appVersion is its default image tag; the comment above it names the image",
      customType: 'regex',
      managerFilePatterns: ['/^charts/[^/]+/Chart\\.yaml$/'],
      matchStrings: ['# renovate: image=(?<depName>\\S+)\\s+appVersion: "?(?<currentValue>[^"\\s]+)"?'],
      datasourceTemplate: 'docker',
    },
  ],
  // The subchart archives committed under charts/*/charts stay in step with
  // Chart.lock.
  postUpdateOptions: ['helmUpdateSubChartArchives'],
  packageRules: [
    {
      description: 'ct lint fails a changed chart whose version did not go up, so an update to a chart bumps it too: minor for a major update, patch otherwise',
      matchFileNames: ['charts/**'],
      bumpVersions: [
        {
          filePatterns: ['{{packageFileDir}}/Chart.yaml'],
          matchStrings: ['version:\\s(?<version>[^\\s]+)'],
          bumpType: '{{#if isMajor}}minor{{else}}patch{{/if}}',
        },
      ],
    },
    {
      description: 'Major updates wait on the Dependency Dashboard until approved: they usually need migration work',
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
    {
      description: 'Obscura Server image updates automerge once chart lint and install tests pass',
      matchDepNames: ['ghcr.io/obscura-messaging/obscura-server'],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
    },
    {
      description: 'Workflow updates never release a chart: they merge without a PR once CI passes on the branch, and a failure opens one',
      matchFileNames: ['.github/workflows/**'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      // The workflow runs on push for this prefix, since these branches have no PR.
      additionalBranchPrefix: 'tooling-',
      automerge: true,
      automergeType: 'branch',
      schedule: ['* * * * 1'],
    },
  ],
}
